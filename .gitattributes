# ============================================================
# 1. 全局默认规则：让 Git 自动决定文件类型并自动处理换行符
# ============================================================
* text=auto

# ============================================================
# 2. 明确指定文本文件，并强制使用 LF（推荐跨平台）
# ============================================================

# Python 源文件
*.py           text eol=lf
*.pyi          text eol=lf
*.pyx          text eol=lf
*.pxd          text eol=lf

# 前端源文件（JS/TS/HTML/CSS）
*.js           text eol=lf
*.ts           text eol=lf
*.jsx          text eol=lf
*.tsx          text eol=lf
*.html         text eol=lf
*.htm          text eol=lf
*.css          text eol=lf
*.scss         text eol=lf
*.sass         text eol=lf
*.less         text eol=lf
# Vue 单文件组件
*.vue          text eol=lf

# 配置文件 / 数据交换格式
*.json         text eol=lf
*.json5        text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.toml         text eol=lf
*.xml          text eol=lf
# SVG 本质是文本，且常被前端引用
*.svg          text eol=lf

# Shell 脚本（Linux/macOS）
*.sh           text eol=lf
*.bash         text eol=lf
*.zsh          text eol=lf
*.fish         text eol=lf

# 锁文件 / 依赖清单（保持 LF 可以减少 diff 噪音）
package-lock.json   text eol=lf
yarn.lock           text eol=lf
pnpm-lock.yaml      text eol=lf
requirements.txt    text eol=lf
Pipfile.lock        text eol=lf
poetry.lock         text eol=lf

# 各种配置文件（.gitignore, .editorconfig 等）
*.ini          text eol=lf
*.cfg          text eol=lf
*.conf         text eol=lf
*.editorconfig text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.dockerignore  text eol=lf
.eslintrc*     text eol=lf
.prettierrc*   text eol=lf
.babelrc*      text eol=lf

# ============================================================
# 3. Windows 批处理文件需要 CRLF（否则可能无法运行）
# ============================================================
*.bat          text eol=crlf
*.cmd          text eol=crlf

# ============================================================
# 4. 明确标记二进制文件（不转换换行符，不进行 diff）
# ============================================================

# 图片
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.webp         binary
*.avif         binary
*.bmp          binary
*.tiff         binary
*.psd          binary

# 字体
*.ttf          binary
*.otf          binary
*.woff         binary
*.woff2        binary

# 音视频
*.mp3          binary
*.mp4          binary
*.avi          binary
*.mov          binary
*.wav          binary

# 压缩包
*.zip          binary
*.gz           binary
*.tar          binary
*.tgz          binary
*.bz2          binary
*.7z           binary
*.rar          binary

# 可执行文件 / 动态库
*.exe          binary
*.dll          binary
*.so           binary
*.dylib        binary

# Python 字节码
*.pyc          binary
*.pyo          binary
*.pyd          binary

# 数据库 / 其他二进制数据
*.db           binary
*.sqlite       binary
*.sqlite3      binary
# 编译后的语言文件（若使用 gettext）
*.mo           binary